{
  "name": "agentic-spaced-repetition",
  "version": "0.1.0",
  "description": "An FSRS spaced-repetition engine built for agents: a deck SDK with an MCP server, an app server and an admin CLI over it",
  "license": "MIT",
  "type": "module",
  "bin": {
    "srs": "./build/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/ __tests__/",
    "lint:fix": "eslint src/ __tests__/ --fix",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:cli": "tsx src/cli/index.ts",
    "dev:mcp": "tsx src/mcp/server.ts",
    "dev:app": "tsx src/app/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.4.1",
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-better-sqlite3": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^12.0.0",
    "dotenv": "^16.6.1",
    "prisma": "^7.6.0",
    "ts-fsrs": "^6.0.0",
    "typescript": "^5.9.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "tsx": "^4.0.0",
    "typescript-language-server": "^6.0.2",
    "vitest": "^3.0.0"
  }
}
