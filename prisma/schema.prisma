datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Deck {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  cards       Card[]
}

model Card {
  id         String    @id @default(cuid())
  deckId     String
  deck       Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front      String
  back       String
  tags       String    @default("")
  category   String?
  type       String    @default("guided")
  // Parent card id when this row was created via createCard's inheritFrom
  // (a split/derive). Marks it as deck maintenance, not new intake.
  inheritedFrom String?
  // A code card's exercise as JSON (src/core/exercises.ts), null on any other
  // card. front and back are written from it, so every other reader of a card
  // works on one unchanged.
  exercise   String?
  // FSRS scheduling
  due        DateTime  @default(now())
  stability  Float     @default(0)
  difficulty Float     @default(0)
  reps       Int       @default(0)
  lapses     Int       @default(0)
  state      Int       @default(0)
  lastReview DateTime?
  interval   Float     @default(0)
  // Position in the (re)learning steps, ts-fsrs's learning_steps: Anki keeps
  // the same counter, and without it every learning card would restart at step 1.
  learningStep Int     @default(0)
  // Leech enforcement (see src/core/leeches.ts)
  // Stamped when the study loop serves this card at or over LEECH_LAPSES; a
  // stamp that is not covered by leechDeferredLapses blocks the next card.
  leechFlaggedAt      DateTime?
  // The lapse count the developer chose to keep this card at. The block lifts
  // until the card fails again (lapses > leechDeferredLapses).
  leechDeferredLapses Int?
  // RAG
  embedding  String?
  // Metadata
  suspended  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviews    Review[]
  note       CardNote?

  @@index([deckId])
  @@index([due])
  @@index([state])
  @@index([category])
}

model Review {
  id          String   @id @default(cuid())
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating      Int
  responseMs  Int?
  stability   Float
  difficulty  Float
  elapsedDays Float
  reviewedAt  DateTime @default(now())
  // The card's state just before this review (ts-fsrs State: 0 new, 1 learning,
  // 2 review, 3 relearning), as Anki's revlog `type` records it; anki-sync
  // carries it both ways. Null on rows from before it was kept. A rest day's
  // share counts only reviews of Review cards (study-ahead.ts), not steps.
  state       Int?

  @@index([cardId])
  @@index([reviewedAt])
}

// What the developer wants done about a card, noted mid-study (Omvida's
// Ctrl+N) so the session goes on: an edit to make, or something to understand
// better. One per card, markdown, kept until a fix session resolves it
// (src/core/card-notes.ts) and deleted with its card. A table rather than a
// Card column: a note is not the card's content, and writing one must not move
// Card.updatedAt, which every reader takes for an edit of the card.
model CardNote {
  cardId    String   @id
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudySession {
  id             String    @id @default(cuid())
  startTime      DateTime  @default(now())
  endTime        DateTime?
  cardsReviewed  Int       @default(0)
  newCards       Int       @default(0)
  accuracy       Float     @default(0)
  // The open session's queue and position, as JSON (session-service.ts), so a
  // session outlives the process that started it. Null once it has ended.
  queueState     String?

  @@index([startTime])
}

model Config {
  id                       String  @id @default("default")
  // A session's size is maxReviewCardsPerSession: due reviews up to it, new
  // cards filling the rest (at least MIN_NEW_PER_SESSION in pressure.ts).
  // maxNewCardsPerSession only caps that fill; the day's newPerDay caps it too.
  maxNewCardsPerSession    Int     @default(20)
  maxReviewCardsPerSession Int     @default(20)
  requestRetention         Float   @default(0.9)
  practiceFirstMode        Boolean @default(true)
  // Scheduling parameters mirrored from the Anki deck options by anki-sync, so the
  // intervals shown here are the ones Anki shows. Steps are comma-separated
  // ts-fsrs units; fsrsWeights is a JSON array, "" for the library's defaults.
  // easyDays is Anki's Easy Days, seven loads Monday first, "" for none.
  learningSteps            String  @default("1m,10m")
  relearningSteps          String  @default("10m")
  fsrsWeights              String  @default("")
  easyDays                 String  @default("")
  // Anki's daily limits and its collection-wide "new cards ignore review limit";
  // defaults are Anki's.
  newPerDay                 Int     @default(20)
  reviewsPerDay             Int     @default(200)
  newCardsIgnoreReviewLimit Boolean @default(false)
}

// Deletion has to be explicit state, not absence: several machines share one
// AnkiWeb collection, and a card missing from this database is otherwise
// indistinguishable from one created on another machine and not yet synced here.
// anki-sync reads these to tell the two apart. Kept forever; a row is ~40 bytes.
model DeletedCard {
  cardId    String   @id
  deletedAt DateTime @default(now())
}
